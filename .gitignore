# Godot 4+ specific ignores
.godot/
/android/
/test_export/

# Stale editor scratch files
*.tscn[0-9]*.tmp

# The exported web build. Deliberately NOT committed: index.pck bakes in
# whatever config.json held at export time, so committing it would publish the
# Supabase key, and each export is ~40MB of git history. It is deployed straight
# to Vercel from tools/export-web.ps1 output instead. See DEPLOY.md.
/web/

# Real credentials. config.example.json is the committed template.
/config.json
